# Files excluded from the published pub.dev package (does NOT affect git).
# Uses .gitignore syntax. Goal: ship only the package source + a slim example,
# trimming the archive from ~10 MB to a few hundred KB.
#
# NOTE: once a .pubignore exists, pub walks the filesystem instead of using
# `git ls-files`, so normally-untracked build artifacts (.dart_tool/, build/)
# are NO LONGER auto-excluded and must be listed here explicitly. Patterns
# without a leading slash match at any depth (root AND example/).

# Build artifacts & tool caches (regenerated; the 69 MB *.cache.dill lives here)
build/
.dart_tool/

# Screenshots are referenced in README.md via absolute
# raw.githubusercontent.com/.../main/screenshots/... URLs, so pub.dev renders
# them straight from GitHub — no need to bundle them (~8 MB of the archive).
screenshots/

# Editor / IDE state
.idea/
.vscode/
*.iml

# Internal project docs (AI/dev instructions) — not useful to package consumers
CLAUDE.md

# Example app: keep lib/, pubspec.yaml, README.md — drop the platform
# scaffolding, which is regenerated by `flutter create`.
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/test/
example/pubspec.lock
example/devtools_options.yaml
